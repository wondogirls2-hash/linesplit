{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.paragraphsplitter.com" }],
      "destination": "https://paragraphsplitter.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "linesplit.vercel.app" }],
      "destination": "https://paragraphsplitter.com/:path*",
      "statusCode": 301
    }
  ]
}
